rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    // Operadores da Base de Dados (Autenticação direta)
    match /operators/{operatorId} {
      allow read, write: if isValidId(operatorId);
    }

    // Clientes
    match /clients/{clientId} {
      allow read, write: if isValidId(clientId);
    }

    // Faturas
    match /invoices/{invoiceId} {
      allow read, write: if isValidId(invoiceId);
    }

    // Consumo Mensal dos Postos de Abastecimento
    match /stationConsumptions/{recordId} {
      allow read, write: if isValidId(recordId);
    }

    // Configurações do Sistema
    match /settings/{settingsId} {
      allow read, write: if isValidId(settingsId);
    }
  }
}
