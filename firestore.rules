rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    // Operadores da Base de Dados (Autenticação direta e perfis de acesso)
    match /operators/{operatorId} {
      allow get: if isValidId(operatorId);
      allow list: if true;
      allow create, update: if isValidId(operatorId);
      allow delete: if isValidId(operatorId) && isSignedIn();
    }

    // Clientes da Rede de Abastecimento de Água
    match /clients/{clientId} {
      allow get: if isValidId(clientId);
      allow list: if true;
      allow create, update: if isValidId(clientId);
      allow delete: if isValidId(clientId) && isSignedIn();
    }

    // Faturas de Água (Não podem ser apagadas do sistema, apenas canceladas para conformidade legal e auditoria)
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId);
      allow list: if true;
      allow create, update: if isValidId(invoiceId);
      allow delete: if false; // Faturas não podem ser apagadas do sistema, apenas canceladas
    }

    // Registos de Bombeamento e Consumo dos Postos de Abastecimento
    match /stationConsumptions/{recordId} {
      allow get: if isValidId(recordId);
      allow list: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if isValidId(recordId) && isSignedIn();
    }

    // Configurações Gerais do Sistema
    match /settings/{settingsId} {
      allow get: if isValidId(settingsId);
      allow list: if true;
      allow create, update: if isValidId(settingsId);
      allow delete: if isValidId(settingsId) && isSignedIn();
    }

    // Teste de Conexão
    match /test/{docId} {
      allow get, list, write: if true;
    }
  }
}
